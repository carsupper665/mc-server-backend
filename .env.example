
# Optional FGF IDP login. Register this service in the IDP admin console first.
# See ../FGF-IDP-INTEGRATION.md for the complete local setup.
# Issuer example: http://127.0.0.1:15525
# Client ID example: fgf-mc
# Redirect example: http://127.0.0.1:15173/login/fgf/callback
FGF_IDP_ISSUER=
FGF_IDP_CLIENT_ID=
FGF_IDP_CLIENT_SECRET=
FGF_IDP_REDIRECT_URL=

# Java per Minecraft version; empty uses java from PATH.
# Example: JAVA_21=C:\Program Files\Java\jdk-21\bin\java.exe
JAVA_8=
JAVA_17=
JAVA_21=
JAVA_25=

# Reverse proxy / HTTPS (see README "Deployment")
# IPs or CIDRs of the reverse proxy; empty trusts no X-Forwarded-For.
TRUSTED_PROXIES=
# true when served over HTTPS
SESSION_COOKIE_SECURE=false
# Extra cross-origin origins besides FRONTEND_BASE_URL (comma-separated)
CORS_ALLOW_ORIGINS=
